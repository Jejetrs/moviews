# ---- API server (server/index.js) -------------------------------------------
# Neon connection string: Neon console -> Connect. Use the pooled host for serverless hosting.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
API_PORT=3001
# Origins allowed to call the API (comma separated). Add your deployed site URL.
CORS_ORIGIN=http://localhost:3000
# ---- React app (create-react-app reads REACT_APP_*) -------------------------
# Base URL of the API above (no trailing slash)
REACT_APP_API_URL=http://localhost:3001
# TMDB v4 read access token
REACT_APP_ACCESS_TOKEN=...
